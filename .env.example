# =========================================================
# DZURRI PLAYVERSE — Environment variables (CONTOH SAHAJA)
# Di Vercel: Project → Settings → Environment Variables.
# Untuk komputer sendiri: salin ke .env.local (JANGAN komit).
# =========================================================

# Kata laluan Owner Console (/admin/login).
ADMIN_PASSWORD=

# Kandungan PENUH fail JSON "private key" Firebase
# (Firebase Console → Project settings → Service accounts → Generate new private key).
# Tampal seluruh JSON pada satu nilai. Tanpa ini, mod pembangunan menggunakan storan tempatan (.data/).
FIREBASE_SERVICE_ACCOUNT=

# (Pilihan) URL awam laman, cth. https://dzurri-playverse.vercel.app
SITE_URL=
